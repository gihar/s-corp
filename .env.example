# Telegram Bot
BOT_TOKEN=your_telegram_bot_token

# Database (Railway provides this automatically when you add a PostgreSQL plugin)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/protocol_bot

# Claude AI (required)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI Whisper STT (optional — enable for voice transcription)
OPENAI_API_KEY=

# YooKassa payments (optional)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Webhook port for YooKassa notifications
WEBHOOK_PORT=8080

# Comma-separated Telegram user IDs with /admin access
# e.g. ADMIN_USER_IDS=123456789,987654321
ADMIN_USER_IDS=

# Verbose logging (not recommended in production)
DEBUG=false
